# Expo exposes EXPO_PUBLIC_* values to the mobile bundle.
# Copy to .env.local or set this variable in the shell before starting Expo.

# Android emulator can reach the host machine through 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Physical phones need the LAN IP of the development machine.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api/v1

# iOS simulator and web previews can usually use localhost.
# EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
